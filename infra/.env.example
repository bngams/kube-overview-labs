# cp .env.example .env   (le .env est gitignoré)

# La ZONE Cloudflare (ex: example.com), pas un sous-domaine.
DOMAIN=example.com

# Token API Cloudflare, scope Zone > DNS > Edit (challenge DNS-01, certificat wildcard)
CLOUDFLARE_API_TOKEN=cf-token-xxxxxxxxxxxxxxxxxxxx

# Un mot de passe code-server par binôme (à générer : openssl rand -base64 12)
S1_PASSWORD=change-me-1
S2_PASSWORD=change-me-2
S3_PASSWORD=change-me-3
S4_PASSWORD=change-me-4
S5_PASSWORD=change-me-5
S6_PASSWORD=change-me-6
# Session 7 : formateur (démos)
S7_PASSWORD=change-me-7
